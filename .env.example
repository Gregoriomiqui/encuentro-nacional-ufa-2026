# Make webhook base URL. Example: https://hook.us2.make.com
VITE_MAKE_WEBHOOK_URL=
# Make API key used in x-make-apikey header.
VITE_MAKE_API_KEY=
# Make path for failed-registration validation endpoint. Example: /abc123xyz
VITE_MAKE_FAILED_VALIDATION_PATH=

# Firebase Web App config (Project Settings > General > Your apps > SDK setup and config)
# Example: AIzaSy...
VITE_FIREBASE_API_KEY=
# Example: your-project.firebaseapp.com
VITE_FIREBASE_AUTH_DOMAIN=
# Example: your-project-id
VITE_FIREBASE_PROJECT_ID=
# Example: 1:1234567890:web:abcdef123456
VITE_FIREBASE_APP_ID=
# Example: 1234567890
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Example: your-project.appspot.com
VITE_FIREBASE_STORAGE_BUCKET=
